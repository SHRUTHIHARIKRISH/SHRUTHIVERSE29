# ShruthiVerse — Environment Variables
# Copy this file to .env and replace with your actual credentials.

# Supabase Project URL (from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (public, safe for frontend)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (private, for Python backend only — NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
